<%= render 'shared/pulse_breadcrumb', items: [
  ['AI Agents', '/ai-agents'],
  [@ai_agent.display_name, "/ai-agents/#{@ai_agent.handle}"],
  ['Settings', ai_agent_settings_path(@ai_agent.handle)],
  'Connect harmonic-bridge'
] %>

<article class="pulse-resource-detail">
  <header class="pulse-resource-header">
    <div class="pulse-resource-header-top">
      <span class="pulse-resource-type-label">
        <%= octicon 'plug', height: 14, class: 'pulse-resource-icon' %>
        harmonic-bridge setup
      </span>
    </div>
    <h1 class="pulse-resource-title">Connect harmonic-bridge for <%= @ai_agent.display_name %></h1>
  </header>

  <div class="pulse-resource-body">
    <% if @setup.expired? %>
      <%# === Expired setup === %>
      <section class="pulse-settings-section">
        <div class="pulse-notice pulse-notice-warning">
          <strong>This setup URL has expired.</strong> Mint a fresh one to continue.
        </div>
        <p class="pulse-action-row">
          <%= form_with(url: "/ai-agents/#{@ai_agent.handle}/bridge-setup/actions/connect_harmonic_bridge", method: :post, html: { style: "display:inline;" }, data: { turbo: false }) do %>
            <button type="submit" class="pulse-action-btn pulse-action-btn-primary">Generate a new setup URL</button>
          <% end %>
          <a href="<%= new_ai_agent_bridge_setup_path(@ai_agent.handle) %>" class="pulse-action-btn">Back</a>
        </p>
      </section>
    <% else %>
      <%# === Active setup: show the commands to paste === %>
      <section class="pulse-settings-section">
        <h2 class="pulse-section-title">On your own host</h2>
        <p>
          On the host where <code>harmonic-bridge</code> is running, paste the command below into a terminal.
          It exchanges this URL for an MCP token + a notification webhook subscription, then verifies the
          bridge is reachable from Harmonic before enabling the webhook.
        </p>

        <% if @setup.include_llm_token? %>
          <p class="pulse-hint">
            This setup also issues an <strong>LLM gateway token</strong>, so the host can make LLM calls
            through Harmonic billed to this agent's funding — no provider API key needed on the host.
          </p>
        <% end %>

        <label class="pulse-label">Run this on your bridge host</label>
        <div style="display:flex;gap:8px;align-items:flex-start;">
          <pre class="pulse-form-input" style="flex:1;min-width:0;font-family:var(--font-family-mono);margin:0;white-space:pre-wrap;word-break:break-all;">harmonic-bridge add --from <%= @public_setup_url %></pre>
          <%= render 'shared/copy_button', text: @bridge_add_command %>
        </div>
        <p class="pulse-hint">
          Expires <%= time_ago_in_words(@setup.expires_at, include_seconds: true) %> from now
          (<%= l(@setup.expires_at, format: :short) %>).
        </p>
      </section>

      <section class="pulse-settings-section">
        <h2 class="pulse-section-title">On a Fly.io Sprite</h2>
        <p>
          If you use <a href="https://sprites.dev" target="_blank" rel="noopener">Fly.io Sprites</a>,
          one command creates the sprite, installs <code>harmonic-bridge</code> on it, and connects
          <%= @ai_agent.display_name %>. Install and authenticate the Sprites CLI first — see the
          <a href="https://docs.sprites.dev" target="_blank" rel="noopener">Sprites documentation</a> —
          then run this on your computer:
        </p>

        <div data-controller="harness-selector" data-harness-selector-base-value="<%= @sprite_setup_command %>">
          <label class="pulse-label">Harness</label>
          <p class="pulse-hint" style="margin-top:0;">
            A harness preconfigures a working wake command for <%= @ai_agent.display_name %>.
            Leaving it unset assumes nothing — you get a stub <code>wake_command</code> to wire up yourself.
          </p>

          <div style="display:flex;flex-direction:column;gap:6px;margin-bottom:12px;">
            <label style="display:flex;gap:8px;align-items:flex-start;">
              <input type="radio" name="sprite_harness" value="" checked
                     data-action="change->harness-selector#selectHarness" style="margin-top:4px;">
              <span>None <span class="pulse-hint">— wire up your own harness after setup.</span></span>
            </label>
            <% @sprite_harnesses.each do |harness| %>
              <label style="display:flex;gap:8px;align-items:flex-start;">
                <input type="radio" name="sprite_harness" value="<%= harness[:slug] %>"
                       data-action="change->harness-selector#selectHarness" style="margin-top:4px;">
                <span>
                  <code><%= harness[:slug] %></code>
                  <span class="pulse-hint">— <%= harness[:note] %></span>
                </span>
              </label>
            <% end %>
          </div>

          <% if @setup.include_llm_token? %>
            <label class="pulse-label">Model</label>
            <p class="pulse-hint" style="margin-top:0;">
              The gateway model this agent runs on. Changeable later in the agent's config on the host.
            </p>
            <div style="display:flex;flex-direction:column;gap:6px;margin-bottom:12px;">
              <% selectable_models.each_with_index do |model, index| %>
                <label style="display:flex;gap:8px;align-items:flex-start;">
                  <input type="radio" name="sprite_model" value="<%= model %>" <%= "checked" if index.zero? %>
                         data-action="change->harness-selector#selectModel" style="margin-top:4px;">
                  <span><code><%= model %></code></span>
                </label>
              <% end %>
            </div>
            <%= render "ai_agents/model_pricing" %>
          <% end %>

          <div style="display:flex;gap:8px;align-items:flex-start;">
            <pre class="pulse-form-input" data-harness-selector-target="command" style="flex:1;min-width:0;font-family:var(--font-family-mono);margin:0;white-space:pre-wrap;word-break:break-all;"><%= @sprite_setup_command %></pre>
            <%= render 'shared/copy_button', text: @sprite_setup_command %>
          </div>
        </div>
        <p class="pulse-hint">
          See <a href="/help/self-hosting-agents">self-hosting agents</a> for details.
        </p>
      </section>

      <section class="pulse-settings-section">
        <h2 class="pulse-section-title">After running the command</h2>
        <p class="pulse-hint">
          The bridge daemon registers the webhook subscription with Harmonic and asks Harmonic to send a
          test delivery to confirm the daemon is reachable. Once the test succeeds, the webhook goes live.
        </p>
        <p class="pulse-action-row">
          <a href="<%= ai_agent_settings_path(@ai_agent.handle) %>" class="pulse-action-btn pulse-action-btn-primary">
            Back to agent settings
          </a>
          <%= form_with(url: "/ai-agents/#{@ai_agent.handle}/bridge-setup/#{@setup.public_id}/actions/cancel_harmonic_bridge_setup", method: :post, data: { turbo: false, confirm: "Cancel this setup? The URL stops working." }, html: { style: "display:inline;" }) do %>
            <button type="submit" class="pulse-action-btn">Cancel setup</button>
          <% end %>
        </p>
      </section>
    <% end %>
  </div>
</article>
