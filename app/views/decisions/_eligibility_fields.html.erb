<%#
  Who may propose options, and who may vote. Both are user sets, edited here as
  the compact grammar so a set built through the API — including a multi-clause
  union — round-trips through this form instead of being flattened by a
  narrower control.

  Locals:
    form
    decision — nil on the new-decision form
    variant  — :settings (sections divide with border-bottom) or :form (the
               new-decision form, whose sections divide with border-top).
               Rendering the wrong one puts two rules side by side.
%>
<% variant = local_assigns.fetch(:variant, :settings) %>
<% section_class = variant == :form ? "pulse-form-section" : "pulse-settings-section" %>
<% label_class = variant == :form ? "pulse-form-label" : "pulse-label" %>
<% rule_for = ->(attribute) {
     next nil if decision.nil?
     decision.public_send(:"#{attribute}_rule")&.to_s(collective: @current_collective)
   } %>
<% member_handles = @current_collective.collective_members.includes(:user).filter_map { |m| m.user.handle }.sort %>

<datalist id="eligibility-handles">
  <% member_handles.each do |handle| %>
    <option value="user:<%= handle %>"></option>
  <% end %>
</datalist>

<section class="<%= section_class %>">
  <h2 class="pulse-section-title">
    Who can participate
    <%= render TooltipComponent.new do %>
      Leave empty to allow everyone. Specify a narrower set with
      <a href="/help/user-sets">user set syntax</a> — for example
      <code>user:@alice,@bob role:admin</code>.
    <% end %>
  </h2>

  <div class="pulse-form-group">
    <label for="proposer_eligibility" class="<%= label_class %>">Who can add options</label>
    <%= form.text_field :proposer_eligibility, value: rule_for.call(:proposer_eligibility),
                        list: "eligibility-handles", class: "pulse-form-input",
                        placeholder: "everyone" %>
  </div>

  <div class="pulse-form-group">
    <label for="voter_eligibility" class="<%= label_class %>">Who can vote</label>
    <%= form.text_field :voter_eligibility, value: rule_for.call(:voter_eligibility),
                        list: "eligibility-handles", class: "pulse-form-input",
                        placeholder: "everyone" %>
  </div>
</section>
