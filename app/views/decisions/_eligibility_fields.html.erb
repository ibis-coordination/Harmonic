<%#
  Who may vote, and who may propose options. Both are unions of clauses, edited
  here as the compact grammar so a rule built through the API — including a
  multi-clause union — round-trips through this form instead of being flattened
  by a narrower control.

  Locals: form, decision (nil on the new-decision form).
%>
<% rule_for = ->(attribute) {
     next nil if decision.nil?
     decision.public_send(:"#{attribute}_rule")&.to_s(collective: @current_collective)
   } %>
<% member_handles = @current_collective.collective_members.includes(:user).filter_map { |m| m.user.handle }.sort %>

<datalist id="eligibility-handles">
  <% member_handles.each do |handle| %>
    <option value="user:<%= handle %>"></option>
  <% end %>
</datalist>

<section class="pulse-settings-section">
  <h2 class="pulse-section-title">Who can take part</h2>
  <p class="pulse-section-description">
    Leave these empty unless this decision belongs to a smaller group than the collective.
    A rule is a list of clauses separated by spaces, and anyone matching any clause qualifies —
    for example <code>user:alice,bob role:admin</code>.
    Use <code>members</code> on its own, or combine <code>role:&lt;name&gt;</code>,
    <code>list:&lt;id&gt;</code>, and <code>user:&lt;handle&gt;,&lt;handle&gt;</code>.
  </p>

  <p class="pulse-form-row">
    <label for="voter_eligibility" class="pulse-label">Who can vote</label>
    <%= form.text_field :voter_eligibility, value: rule_for.call(:voter_eligibility),
                        list: "eligibility-handles", class: "pulse-form-input",
                        placeholder: "everyone" %>
  </p>

  <p class="pulse-form-row">
    <label for="proposer_eligibility" class="pulse-label">Who can add options</label>
    <%= form.text_field :proposer_eligibility, value: rule_for.call(:proposer_eligibility),
                        list: "eligibility-handles", class: "pulse-form-input",
                        placeholder: "everyone" %>
  </p>
</section>
